<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator1.CalcPage1"
             Title="CalcPage1">
    <VerticalStackLayout Spacing="10">
        <Label Text="" x:Name="lblResult" FontSize="30" />
        <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" HeightRequest="600" ColumnSpacing="10" RowSpacing="10">
            <Button Text="1" Grid.Row="0" Grid.Column="0" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="2" Grid.Row="0" Grid.Column="1" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="3" Grid.Row="0" Grid.Column="2" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="4" Grid.Row="1" Grid.Column="0" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="5" Grid.Row="1" Grid.Column="1" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="6" Grid.Row="1" Grid.Column="2" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="7" Grid.Row="2" Grid.Column="0" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="8" Grid.Row="2" Grid.Column="1" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="9" Grid.Row="2" Grid.Column="2" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="0" Grid.Row="3" Grid.Column="1" Clicked="Button_Clicked_num" BackgroundColor="Aqua" TextColor="Black"/>
            <Button Text="+" Grid.Row="0" Grid.Column="3" Clicked="Button_Clicked_operator" BackgroundColor="Black"/>
            <Button Text="-" Grid.Row="1" Grid.Column="3" Clicked="Button_Clicked_operator" BackgroundColor="Black"/>
            <Button Text="*" Grid.Row="2" Grid.Column="3" Clicked="Button_Clicked_operator" BackgroundColor="Black"/>
            <Button Text="/" Grid.Row="3" Grid.Column="3" Clicked="Button_Clicked_operator" BackgroundColor="Black"/>
            <Button Text="ac" Grid.Row="3" Grid.Column="0" Clicked="Button_Clicked_clear" BackgroundColor="LightPink"/>
            <Button Text="=" Grid.Row="3" Grid.Column="2" Clicked="Button_Clicked_equal" BackgroundColor="LightPink"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>